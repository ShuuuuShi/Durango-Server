<Window x:Class="DinoWorld.Launcher.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ตั้งค่า Launcher" Height="300" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgPanel}" WindowStyle="ToolWindow">
    <StackPanel Margin="20">
        <TextBlock Text="ที่อยู่เซิร์ฟเวอร์" Foreground="{StaticResource TextDim}" FontSize="12"/>
        <TextBox x:Name="AddrBox" Margin="0,5,0,0" Padding="8,6" FontSize="13"
                 Background="#00000055" Foreground="{StaticResource TextMain}"
                 BorderBrush="#3A2A36" CaretBrush="{StaticResource Pink}"/>
        <TextBlock Text="เช่น 127.0.0.1:8190 หรือ 192.168.1.50 (ใช้พอร์ต 8190 เองถ้าไม่ระบุ)"
                   Foreground="#66A08BA0" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>

        <CheckBox x:Name="AutoPatchBox" Content="อัปเดตเกมอัตโนมัติก่อนเข้าเล่น" Margin="0,16,0,0"
                  Foreground="{StaticResource TextMain}" FontSize="13"/>

        <WrapPanel Margin="0,18,0,0">
            <Button Content="💾 บันทึก" Style="{StaticResource PinkButton}" Click="Save_Click" MinWidth="110"/>
            <Button Content="ยกเลิก" Style="{StaticResource SideButton}" Click="Cancel_Click" MinWidth="90" Margin="10,0,0,0"/>
        </WrapPanel>
    </StackPanel>
</Window>
