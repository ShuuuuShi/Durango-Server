<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DinoWorld Launcher — หน้าต่างเปิดเกมแบบเกมออนไลน์ทั่วไป (GS/Ragnarok style)
    • แสดงประกาศ/อีเวนต์จาก GET http://<server>/launcher/news
    • แสดงสถานะเซิร์ฟ (ออนไลน์/ผู้เล่น/ping/เวอร์ชัน) จาก GET /launcher/status
    • ปุ่ม "เข้าเกม" = เปิด DurangoV2.exe พร้อม env DURANGO_AUTOCONNECT=<ip:port>
      (client อ่าน env นี้อยู่แล้ว — ดู client/Durango.Offline/Server.cs AutoConnectTarget)
    • อัปเดตเกม: logic เดียวกับ tools/Updater (manifest → zip → SHA256 → temp → robocopy /MIR)
      fail-safe ทุกขั้น: พังตรงไหน = ข้ามการอัปเดตแล้วยังกดเข้าเกมเวอร์ชันเดิมได้เสมอ

    build:   dotnet build tools/Launcher -c Release
    publish: dotnet publish tools/Launcher -c Release -r win-x64 -p:SelfContained=true
             (วาง DinoWorldLauncher.exe ไว้ในโฟลเดอร์เกม ข้าง ๆ DurangoV2.exe)
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DinoWorldLauncher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- [4 ก.ย. 2026] WPF + single-file ต้องแตก native DLL (PresentationNative/wpfgfx) ตอนรัน
         ไม่งั้นเปิดหน้าต่างแล้วล้ม DllNotFoundException ใน HwndSubclass (เจอจริงตอนเทส) -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- บีบอัด assemblies ในตัว single-file — ลดขนาดจาก ~120MB เหลือ ~60-70MB สำหรับแจก -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyTitle>DinoWorld Launcher</AssemblyTitle>
    <Product>DinoWorld</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
