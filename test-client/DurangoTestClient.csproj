<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\server\GameCode\**\*.cs" Link="GameCode\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\server\Shims\**\*.cs" Link="Shims\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\server\ServerCore\**\*.cs" Link="ServerCore\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MsgPack.Cli" Version="1.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- ต้องมีตัวเดียวกับ server/DurangoServer.csproj — ระบบ mod (24 ส.ค. 2026) เพิ่ม ProjectReference
         นี้ใน server แต่ลืมเพิ่มที่นี่ด้วย ทำให้ test-client build ไม่ผ่าน (IModPlayer หาไม่เจอ) เพราะ
         project นี้ compile ไฟล์ ServerCore\**\*.cs ทั้งโฟลเดอร์ตรง ๆ (ไม่ได้ reference server.dll) -->
    <ProjectReference Include="..\mod-sdk\DurangoModSdk.csproj" />
  </ItemGroup>

</Project>
